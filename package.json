{
  "name": "cubecrusher-desktop",
  "productName": "Cubecrusher",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for the Cubecrusher Unraid server",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5180 && cross-env VITE_DEV_URL=http://localhost:5180 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test src/lib/*.test.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.5",
    "wait-on": "^8.0.5"
  }
}
